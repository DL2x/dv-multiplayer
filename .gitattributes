# Set default behavior to automatically normalize line endings
* text=auto

# Force CRLF line endings for C# files
*.cs text eol=crlf

# Force CRLF for other common Windows development files (optional)
*.csproj text eol=crlf
*.sln text eol=crlf

# Force LF for shell scripts and systemd units so they run on Linux
# (a CRLF in the shebang line breaks them: "/usr/bin/env: 'bash\r'").
*.sh text eol=lf
*.service text eol=lf
